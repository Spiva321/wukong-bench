<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <AssemblyName>WukongBench</AssemblyName>
    <RootNamespace>WukongBench</RootNamespace>
    <!-- System.Management (WMI) и Win32 P/Invoke работают только на Windows.
         Единый TFM, чтобы проект собирался на любой ОС и тестировался на mac. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>